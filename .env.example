# Copy to .env and fill in. Never commit .env.

# API port (default 3847)
# PORT=3847

# PostgreSQL (required)
DATABASE_URL=postgresql://user:password@host:5432/electionnight_db

# Early voting roster UI + API (optional)
# EV_ROSTER_ENABLED=1
# VITE_EV_ROSTER_ENABLED=1

# Montgomery eResults fetch behavior (optional)
# MONTGOMERY_DISABLE_ELECTION_DNS_ALIAS=0
