# Copy to .env and fill in. Never commit .env.

# API port (default 3847; Render sets PORT automatically)
# PORT=3847

# PostgreSQL (required)
DATABASE_URL=postgresql://user:password@host:5432/electionnight_db
# DATABASE_SSL=true

# --- Production frontend (Render static site) ---
# Public URL of the API service, no trailing slash — required when UI and API are separate services
# VITE_API_BASE_URL=https://your-election-api.onrender.com

# Extra CORS origins (comma-separated), in addition to *.onrender.com
# CORS_ALLOWED_ORIGINS=https://electiontracker-frontend.onrender.com

# Civix / Texas SOS (optional — Render datacenter IPs often get HTTP 403 from goelect.txelections.civixapps.com)
# On Render (RENDER=true), the API uses the last sos_results DB snapshot unless a cookie is set.
# Easiest: Settings → Link Civix (one-time bookmarklet on goelect). Or set CIVIX_COOKIE on the API env.
# CIVIX_PREFER_CACHE=1  force cache-only when a snapshot exists
# CIVIX_COOKIE= paste session cookie from browser DevTools if your host is blocked
# CIVIX_REFERER=https://goelect.txelections.civixapps.com/ivis-enr-ui/
# CIVIX_ORIGIN=https://goelect.txelections.civixapps.com

# Early voting roster UI + API (optional)
# EV_ROSTER_ENABLED=1
# VITE_EV_ROSTER_ENABLED=1

# Montgomery eResults fetch behavior (optional)
# MONTGOMERY_DISABLE_ELECTION_DNS_ALIAS=0
