# Copy to .env and fill in. Never commit .env.

# API port (default 3847)
# PORT=3847

# Optional SQL Server; if unset, the app uses SQLite under server/data/
# MSSQL_SERVER=
# MSSQL_DATABASE=electionnighttracker
# MSSQL_USER=
# MSSQL_PASSWORD=
# MSSQL_ENCRYPT=true
# MSSQL_TRUST_CERT=true

# Montgomery eResults fetch behavior (optional)
# MONTGOMERY_DISABLE_ELECTION_DNS_ALIAS=0
